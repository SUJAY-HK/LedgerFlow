meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: basic
}

body:json {
  {
    "email" : "lgf@email.com",
    "password" : "12345678"
  }
}

vars:pre-request {
  BASE_URL: http://localhost:8080/
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("ACCESS_TOKEN", res.body.accessToken);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
