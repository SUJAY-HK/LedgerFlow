meta {
  name: Create Transfer
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/v1/transfers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "recipientId": "{{RECIPIENT_ID}}",
    "amount": 500.00
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
